# Copy to .env for local dev. On Railway paste the same keys into Variables > RAW Editor.
# The ONLY env file in the repo.

# Railway: add a Postgres service, then set this to ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Public site address, no trailing slash. Used for canonical links and the sitemap.
FRONTEND_URL=https://yourdomain.com

# ---- Email: enquiry notifications and guest confirmations ----
# Inbox that receives new enquiries
EMAIL_USER=
# Recommended on Railway (SMTP is blocked on Hobby/Trial): resend.com API key + verified domain sender
RESEND_API_KEY=
EMAIL_FROM=Mid Orchard <enquiries@yourdomain.com>

# Optional SMTP fallback (only used if RESEND_API_KEY is not set)
# HOST=
# SERVICE=
# EMAIL_PORT=
# EMAIL_PASS=

# ---- One-time migration only (old MongoDB), not needed after the data is moved ----
# MONGODB=
