# Copy to .env for local dev. On Railway paste the same keys into Variables > RAW Editor.
# The ONLY env file in the repo (backend and frontend both read it).

# ---- Server ----
MONGODB=
JWT_SECRET=
JWTPRIVATEKEY=
# Public site URL. BASE_URL must end with "/", FRONTEND_URL must not.
BASE_URL=https://yourdomain.com/
FRONTEND_URL=https://yourdomain.com

# ---- Email (nodemailer) ----
HOST=
SERVICE=
EMAIL_PORT=
# Leave unset for false (any non-empty value, even "false", is treated as true)
# SECURE=
EMAIL_USER=
EMAIL_PASS=

# ---- Frontend (VITE_*; baked in at build time) ----
VITE_FIREBASE_API_KEY=
# Leave unset in production: the app calls /api on the same domain
# VITE_API_URL=
